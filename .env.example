# Application Environment Configuration
# Copy this file to .env and customize for local development. Never commit .env to version control!

# App Environment (development, testing, production)
ENVIRONMENT=development
APP_NAME=swe-journey-app
DEBUG=true

# Database Configuration (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=swe_journey_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/swe_journey_dev

# Authentication & Security
SECRET_KEY=change-this-insecure-key-to-a-32-byte-hex-string-for-local-dev
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Frontend Configuration
VITE_API_URL=http://localhost:8000/api/v1
PORT=3000
